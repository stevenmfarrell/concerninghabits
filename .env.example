DATABASE_URL="file:./dev.db"
# The AI model for designing habits, filling in entries, charts and formulas, as "<provider>:<model>".
# Providers: google, anthropic, openai, or local (any OpenAI-compatible server). Defaults to Gemini.
AI_MODEL="google:gemini-flash-lite-latest"
GOOGLE_GENERATIVE_AI_API_KEY="yourapikeyhere"
# AI_MODEL="anthropic:claude-haiku-4-5"
# ANTHROPIC_API_KEY="yourapikeyhere"
# AI_MODEL="openai:gpt-5-mini"
# OPENAI_API_KEY="yourapikeyhere"
# A local model, e.g. Ollama (LM Studio is http://localhost:1234/v1). AI_API_KEY only if the server wants one.
# AI_MODEL="local:qwen3:8b"
# AI_BASE_URL="http://localhost:11434/v1"
# AI_API_KEY=""
# Jev (TypeSafe) matches what you say on the dashboard to one of your habits
TYPESAFE_API_KEY="yourapikeyhere"
# MQTT Integration for Home Assistant
MQTT_URL="mqtt://homeassistant.local:1883"
# MQTT_USERNAME="your-username"
# MQTT_PASSWORD="your-password"
# MQTT_TOPIC_PREFIX="concerninghabits"
