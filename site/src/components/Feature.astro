---
// One feature: a heading and text beside a screenshot, swapping sides with `flip` so a run of them
// zigzags down the page
interface Props {
  id?: string;
  title: string;
  flip?: boolean;
}

const { id, title, flip = false } = Astro.props;
---

<section class:list={['feature', { flip }]} id={id}>
  <div class="text">
    <h2>{title}</h2>
    <slot />
  </div>
  <slot name="media" />
</section>

<style>
  .feature {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding: 4rem 0;
  }

  @media (min-width: 52rem) {
    .feature {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: 5rem;
      padding: 5rem 0;
    }

    .feature.flip {
      grid-template-columns: 17rem minmax(0, 1fr);
    }

    .feature.flip .text {
      order: 2;
    }
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.4rem, 3vw, 1.65rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .text :global(p) {
    margin: 0 0 1rem;
    color: var(--ink-muted);
    font-size: 1.05rem;
    max-width: 34rem;
  }
</style>
