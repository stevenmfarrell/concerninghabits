---
// The landing page: what Concerning Habits is, its main features with screenshots, and how to get it
import { AlarmClock, CloudOff, Cpu, DatabaseBackup, Moon, Smartphone, TreePalm, Users, Zap } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import Feature from '../components/Feature.astro';
import Ink from '../components/Ink.astro';
import Phone from '../components/Phone.astro';

const GITHUB = 'https://github.com/stevenmfarrell/concerninghabits';
const QUICK_START = `${GITHUB}#quick-start`;

const more = [
  { icon: CloudOff, title: 'Works offline', text: 'Installed on your phone, it keeps working without a connection, and anything you log syncs once you’re back online.' },
  { icon: Users, title: 'Households', text: 'Everyone gets their own account. Share a habit and each person logs their own entries.' },
  { icon: AlarmClock, title: 'Reminders', text: 'A push notification when you’re running late on a habit, set per habit and per device.' },
  { icon: TreePalm, title: 'Skips and vacations', text: 'Skip a habit for today or the week, or take a vacation, without it counting against you.' },
  { icon: Zap, title: 'Automations', text: 'Log from iOS Shortcuts, Home Assistant or an NFC tag with an API key, and publish entries to MQTT.' },
  { icon: Cpu, title: 'AI models', text: 'Gemini, Claude or OpenAI, a model running on your own machine through Ollama or LM Studio, or none at all.' },
  { icon: DatabaseBackup, title: 'Your data', text: 'One SQLite database on your own server, with backup and restore as JSON or CSV.' },
  { icon: Moon, title: 'Light and dark', text: 'Follows your device, or pick one.' },
];

const compose = `services:
  concerning-habits:
    image: ghcr.io/stevenmfarrell/concerninghabits:latest
    ports:
      - "3000:3000"
    environment:
      - GOOGLE_GENERATIVE_AI_API_KEY=your-key
    volumes:
      - data:/app/data
    restart: unless-stopped

volumes:
  data:`;
---

<Base
  title="Concerning Habits: a self-hosted, AI-powered habit tracker"
  description="A self-hosted habit tracker for you and your household. Log by tapping, or by saying, typing or photographing what you did, and AI fills in the details. It works offline."
>
  <header class="nav">
    <nav>
      <a href="#features">Features</a>
      <a href="#self-host">Self-host</a>
      <a href={GITHUB}>GitHub</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div>
        <h1 class="art">
          <Ink art="hobbit-hole" class="art-hill" />
          <Ink art="title-text" alt="Concerning Habits" class="art-title" />
          <Ink art="plant-icon" class="art-plant" />
        </h1>
        <p class="lead">A self-hosted habit tracker for you and your household.</p>
        <p class="pitch">
          Log a habit with a tap, or say, type or photograph what you did and AI fills in the details. It
          installs on your phone like an app and works offline.
        </p>
        <div class="actions">
          <a class="button primary" href={QUICK_START}>Quick Start</a>
          <a class="button" href={GITHUB}>GitHub</a>
        </div>
        <p class="note">A hosted version, and apps for Android and iPhone, are on the way.</p>
      </div>
      <Phone
        src="/screenshots/habit.png"
        alt="A habit's page on a phone: Morning Run, thriving, with a Log Habit button and six months of activity"
        eager
      />
    </section>

    <div id="features">
      <Feature title="Logging by voice, text or photo" flip>
        <p>
          Say or type “ran 3.2 miles in 27 minutes” and it fills in the distance and time on your run. A photo
          works too, of a bathroom scale for example.
        </p>
        <p>
          Describe a new habit, like “I want to drink more water”, and it drafts the habit and what to record
          for it, for you to check before saving.
        </p>
        <Phone slot="media" src="/screenshots/smart-entry.png" alt="The entry panel, with “ran 3.2 miles in 27 minutes” typed in and example phrases below" />
      </Feature>

      <Feature title="The Agenda">
        <p>
          What’s due now, what’s coming up, and any limits you’ve set, like at most 4 drinks a week. Tap a
          habit’s ring to log it, or swipe to skip it.
        </p>
        <p>
          Each habit has its own schedule: daily, certain weekdays, a few times a week, every few days, or
          whenever you like.
        </p>
        <Phone slot="media" src="/screenshots/agenda.png" darkSrc="/screenshots/agenda-dark.png" alt="The Agenda: Morning Run, Floss and Read due now, Vacuum and Laundry upcoming, and a weekly limit on Drinks" />
      </Feature>

      <Feature title="Health instead of streaks" flip>
        <p>
          Each habit shows a plant for how you’ve kept it up over the last few weeks: thriving, taking root,
          or needing care.
        </p>
        <p>
          Missing a day lowers it a little rather than resetting it to zero, and skips and vacations don’t
          count against it.
        </p>
        <Phone slot="media" src="/screenshots/habits.png" alt="All habits, each with a plant showing its health, its schedule and a grid of recent activity" />
      </Feature>

      <Feature title="Fields and charts">
        <p>
          Each habit records what you choose: miles and minutes for a run, pages for a book, nothing at all
          for flossing.
        </p>
        <p>
          Chart any of them, or add calculated fields like pace from distance and time. AI can suggest these,
          or you can set them up yourself.
        </p>
        <Phone slot="media" src="/screenshots/trends.png" alt="A weekly distance chart for Morning Run, above its list of entries" />
      </Feature>
    </div>

    <section class="more">
      <h2>Also</h2>
      <ul>
        {more.map(({ icon: Icon, title, text }) => (
          <li>
            <span class="icon"><Icon size={20} aria-hidden="true" /></span>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="self-host" id="self-host">
      <div>
        <h2>Self-hosting</h2>
        <p>
          It runs as one Docker container, with images for amd64 and arm64, so a home server, a NAS or a
          Raspberry Pi will do. Serve it over https to install it on your phone.
        </p>
        <div class="actions">
          <a class="button primary" href={QUICK_START}>Read the Quick Start</a>
          <a class="button" href={`${GITHUB}/releases`}>Releases</a>
        </div>
      </div>
      <figure>
        <figcaption>docker-compose.yml</figcaption>
        <pre><code>{compose}</code></pre>
      </figure>
    </section>

    <section class="coming">
      <span class="icon"><Smartphone size={22} aria-hidden="true" /></span>
      <div>
        <h2>Coming later</h2>
        <p>
          A hosted version, for anyone who’d rather not run a server, and apps for Android and iPhone.
        </p>
      </div>
    </section>
  </main>

  <footer>
    <Ink art="plant-icon" class="footer-plant" />
    <a href={GITHUB}>GitHub</a>
    <a href={`${GITHUB}/releases`}>Releases</a>
    <span>Free software under the AGPL-3.0 license</span>
  </footer>
</Base>

<style>
  .nav,
  main,
  footer {
    max-width: 68rem;
    margin: 0 auto;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  @media (min-width: 40rem) {
    .nav,
    main,
    footer {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }

  /* Only links: the hero below has the title */
  .nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .nav nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.95rem;
  }

  .nav nav a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .nav nav a:hover {
    color: var(--ink);
  }

  @media (max-width: 30rem) {
    .nav nav a:not(:last-child) {
      display: none;
    }
  }

  .hero {
    display: grid;
    gap: 3rem;
    align-items: center;
    padding: 3rem 0 4rem;
  }

  @media (min-width: 52rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: 5rem;
      padding: 5rem 0 6rem;
    }
  }

  /* The page title: the sign-in page's art, the hill, the title and a plant under it */
  .art {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(100%, 22rem);
    margin: 0 0 2.5rem;
  }

  .art :global(.art-hill),
  .art :global(.art-title) {
    width: 100%;
  }

  .art :global(.art-title) {
    margin-top: 0.5rem;
  }

  .art :global(.art-plant) {
    width: 3rem;
    margin-top: -0.5rem;
  }

  .lead {
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0.75rem;
    max-width: 30rem;
  }

  .pitch {
    font-size: 1.1rem;
    color: var(--ink-muted);
    max-width: 32rem;
    margin: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid var(--line);
    background: var(--surface);
    font-weight: 600;
    text-decoration: none;
  }

  .button:hover {
    border-color: var(--ink-muted);
  }

  .button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .button.primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  .note {
    margin-top: 1.5rem;
    color: var(--ink-muted);
    font-size: 0.95rem;
  }

  #features {
    border-top: 1px solid var(--line);
  }

  #features > :global(.feature + .feature) {
    border-top: 1px solid var(--line);
  }

  .more,
  .self-host,
  .coming {
    border-top: 1px solid var(--line);
    padding: 4rem 0;
  }

  .more h2,
  .self-host h2,
  .coming h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.4rem, 3vw, 1.65rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .more ul {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }

  .more li {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 1rem;
    padding: 1.25rem;
  }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-ink);
    flex-shrink: 0;
  }

  .more h3 {
    margin: 0.9rem 0 0.35rem;
    font-size: 1.05rem;
  }

  .more p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.95rem;
  }

  .self-host {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 52rem) {
    .self-host {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }

  .self-host p {
    color: var(--ink-muted);
    font-size: 1.05rem;
    margin: 0;
    max-width: 34rem;
  }

  figure {
    margin: 0;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 1rem;
    overflow: hidden;
  }

  figcaption {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface-subtle);
    color: var(--ink-muted);
    font-size: 0.85rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  pre {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.78rem;
    line-height: 1.6;
  }

  @media (min-width: 40rem) {
    pre {
      font-size: 0.85rem;
    }
  }

  .coming {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .coming p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 1.1rem;
    max-width: 42rem;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    padding-top: 2rem;
    padding-bottom: 3rem;
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: 0.9rem;
  }

  footer :global(.footer-plant) {
    width: 2.5rem;
    opacity: 0.5;
  }
</style>
