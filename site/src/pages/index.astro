---
// The landing page: what Concerning Habits is, its main features with screenshots, and how to get it
import { AlarmClock, CloudOff, Cpu, DatabaseBackup, Moon, Server, Smartphone, TreePalm, Users, Zap } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import Feature from '../components/Feature.astro';
import Phone from '../components/Phone.astro';

const GITHUB = 'https://github.com/stevenmfarrell/concerninghabits';
const QUICK_START = `${GITHUB}#quick-start`;

const more = [
  { icon: CloudOff, title: 'Works offline', text: 'Installed on your phone, it keeps working without a connection, and anything you log syncs once you’re back online.' },
  { icon: Users, title: 'Made for a household', text: 'Everyone gets their own account. Share a habit and each person logs their own entries.' },
  { icon: AlarmClock, title: 'Reminders', text: 'A push notification when you’re running late on a habit, set per habit and per device.' },
  { icon: TreePalm, title: 'Skips and vacations', text: 'Skip a habit for today or the week, or take a vacation, without it counting against you.' },
  { icon: Zap, title: 'Automations', text: 'Log from iOS Shortcuts, Home Assistant or an NFC tag with an API key, and publish entries to MQTT.' },
  { icon: Cpu, title: 'Your choice of AI', text: 'Gemini, Claude or OpenAI, a model running on your own machine through Ollama or LM Studio, or none at all.' },
  { icon: DatabaseBackup, title: 'Your data stays yours', text: 'One SQLite database on your own server, with backup and restore as JSON or CSV.' },
  { icon: Moon, title: 'Light and dark', text: 'Follows your device, or pick one.' },
];

const compose = `services:
  concerning-habits:
    image: ghcr.io/stevenmfarrell/concerninghabits:latest
    ports:
      - "3000:3000"
    environment:
      - GOOGLE_GENERATIVE_AI_API_KEY=your-key
    volumes:
      - data:/app/data
    restart: unless-stopped

volumes:
  data:`;
---

<Base
  title="Concerning Habits: a self-hosted, AI-powered habit tracker"
  description="A habit tracker for you and your household. Describe a habit and let AI design how you'll track it, then log by tapping, talking, typing or snapping a photo. It works offline, and you can host it yourself."
>
  <header class="nav">
    <a class="brand" href="/">
      <img src="/apple-touch-icon.png" alt="" width="32" height="32" />
      <span>Concerning Habits</span>
    </a>
    <nav>
      <a href="#features">Features</a>
      <a href="#self-host">Self-host</a>
      <a href={GITHUB}>GitHub</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div>
        <h1>Habits that bend instead of break</h1>
        <p class="pitch">
          A habit tracker for you and your household. Describe a habit and AI designs how you’ll track it.
          Log it by tapping, talking, typing or snapping a photo. It works offline, and it runs on your own
          server.
        </p>
        <div class="actions">
          <a class="button primary" href={QUICK_START}>Self-host it, free</a>
          <a class="button" href={GITHUB}>View on GitHub</a>
        </div>
        <p class="note">A hosted version, and apps for Android and iPhone, are on the way.</p>
      </div>
      <Phone
        src="/screenshots/habit.png"
        alt="A habit's page on a phone: Morning Run, thriving, with a Log Habit button and six months of activity"
        eager
      />
    </section>

    <div id="features">
      <Feature eyebrow="Log anything" title="Just say what you did" flip>
        <p>
          Say or type <strong>“ran 3.2 miles in 27 minutes”</strong> and it fills in the distance and the time
          on your run. Or snap a photo, of your bathroom scale say, and it reads the numbers off it.
        </p>
        <p>
          Say <strong>“I want to start drinking more water”</strong> and it sets up the habit for you, with the
          right things to track.
        </p>
        <Phone slot="media" src="/screenshots/smart-entry.png" alt="The entry panel, with “ran 3.2 miles in 27 minutes” typed in and example phrases below" />
      </Feature>

      <Feature eyebrow="Today" title="Your day at a glance">
        <p>
          The Agenda shows what’s due now, what’s coming up, and limits you’ve set, like <strong>at most 4
          drinks a week</strong>. Tap a habit’s ring to log it, or swipe to skip it.
        </p>
        <p>
          Daily, certain weekdays, a few times a week, every few days, or whenever you like: each habit runs on
          its own schedule.
        </p>
        <Phone slot="media" src="/screenshots/agenda.png" darkSrc="/screenshots/agenda-dark.png" alt="The Agenda: Morning Run, Floss and Read due now, Vacuum and Laundry upcoming, and a weekly limit on Drinks" />
      </Feature>

      <Feature eyebrow="Habit health" title="Health, not streaks" flip>
        <p>
          Each habit grows like a plant: <strong>thriving</strong>, <strong>taking root</strong>, or
          <strong>needing care</strong>, based on how you’ve kept it up over the last few weeks.
        </p>
        <p>
          Miss a day and it dips a little, instead of wiping out months of progress. Pick it back up and it
          recovers. Skips and vacations don’t count against you at all.
        </p>
        <Phone slot="media" src="/screenshots/habits.png" alt="All habits, each with a plant showing its health, its schedule and a grid of recent activity" />
      </Feature>

      <Feature eyebrow="Your numbers" title="Track what matters to you">
        <p>
          Every habit has its own fields: miles and minutes for a run, pages for a book, nothing at all for
          flossing.
        </p>
        <p>
          Charts and calculated fields, like your pace worked out from distance and time, come from whatever
          you log. AI can suggest them, or set them up yourself.
        </p>
        <Phone slot="media" src="/screenshots/trends.png" alt="A weekly distance chart for Morning Run, above its list of entries" />
      </Feature>
    </div>

    <section class="more">
      <h2>And everything else</h2>
      <ul>
        {more.map(({ icon: Icon, title, text }) => (
          <li>
            <span class="icon"><Icon size={20} aria-hidden="true" /></span>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="self-host" id="self-host">
      <div>
        <p class="eyebrow"><Server size={16} aria-hidden="true" /> Self-host</p>
        <h2>Running in a couple of minutes</h2>
        <p>
          One Docker container and one file. Images are published for amd64 and arm64, so it runs on a home
          server, a NAS or a Raspberry Pi. Install it on your phone over https and it works like an app.
        </p>
        <div class="actions">
          <a class="button primary" href={QUICK_START}>Read the Quick Start</a>
          <a class="button" href={`${GITHUB}/releases`}>Releases</a>
        </div>
      </div>
      <figure>
        <figcaption>docker-compose.yml</figcaption>
        <pre><code>{compose}</code></pre>
      </figure>
    </section>

    <section class="coming">
      <span class="icon"><Smartphone size={22} aria-hidden="true" /></span>
      <div>
        <h2>Coming next</h2>
        <p>
          A hosted version, so there’s nothing to run yourself, and apps for Android and iPhone. Until then,
          self-hosting has everything, and the app installs on your phone from the browser.
        </p>
      </div>
    </section>
  </main>

  <footer>
    <a href={GITHUB}>GitHub</a>
    <a href={`${GITHUB}/releases`}>Releases</a>
    <span>Free software under the AGPL-3.0 license</span>
  </footer>
</Base>

<style>
  .nav,
  main,
  footer {
    max-width: 68rem;
    margin: 0 auto;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  @media (min-width: 40rem) {
    .nav,
    main,
    footer {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    text-decoration: none;
  }

  .brand img {
    border-radius: 0.5rem;
  }

  .brand span {
    white-space: nowrap;
  }

  .nav nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.95rem;
  }

  .nav nav a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .nav nav a:hover {
    color: var(--ink);
  }

  @media (max-width: 30rem) {
    .nav nav a:not(:last-child) {
      display: none;
    }
  }

  .hero {
    display: grid;
    gap: 3rem;
    align-items: center;
    padding: 3rem 0 4rem;
  }

  @media (min-width: 52rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: 5rem;
      padding: 5rem 0 6rem;
    }
  }

  h1 {
    font-size: clamp(2.4rem, 7vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0 0 1.25rem;
    max-width: 14ch;
  }

  .pitch {
    font-size: 1.2rem;
    color: var(--ink-muted);
    max-width: 34rem;
    margin: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid var(--line);
    background: var(--surface);
    font-weight: 600;
    text-decoration: none;
  }

  .button:hover {
    border-color: var(--ink-muted);
  }

  .button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .button.primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  .note {
    margin-top: 1.5rem;
    color: var(--ink-muted);
    font-size: 0.95rem;
  }

  #features {
    border-top: 1px solid var(--line);
  }

  #features > :global(.feature + .feature) {
    border-top: 1px solid var(--line);
  }

  .more,
  .self-host,
  .coming {
    border-top: 1px solid var(--line);
    padding: 4rem 0;
  }

  .more h2,
  .self-host h2,
  .coming h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .more ul {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }

  .more li {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 1rem;
    padding: 1.25rem;
  }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-ink);
    flex-shrink: 0;
  }

  .more h3 {
    margin: 0.9rem 0 0.35rem;
    font-size: 1.05rem;
  }

  .more p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.95rem;
  }

  .self-host {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 52rem) {
    .self-host {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }

  .self-host p:not(.eyebrow) {
    color: var(--ink-muted);
    font-size: 1.1rem;
    margin: 0;
    max-width: 34rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.5rem;
    color: var(--accent-ink);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  figure {
    margin: 0;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 1rem;
    overflow: hidden;
  }

  figcaption {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface-subtle);
    color: var(--ink-muted);
    font-size: 0.85rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  pre {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.78rem;
    line-height: 1.6;
  }

  @media (min-width: 40rem) {
    pre {
      font-size: 0.85rem;
    }
  }

  .coming {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .coming p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 1.1rem;
    max-width: 42rem;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-top: 2rem;
    padding-bottom: 3rem;
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
</style>
