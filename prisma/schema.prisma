generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String        @id @default(uuid())
  name                String
  email               String        @unique
  passwordHash        String
  isAdmin             Boolean       @default(false)
  habitLogs           HabitLog[]
  habits              Habit[]
  habitMemberships    HabitMember[]
  categories          Category[]
  bedtime             String        @default("01:00")
  weekStartsOn        String        @default("sunday")
  useEmojiTitle       Boolean       @default(true)
  emojiModifier       String?
  passwordNeedsUpdate Boolean       @default(false)
  unitSystem          String        @default("imperial")
  createdAt           DateTime      @default(now())
  sessions            Session[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Habit {
  publishToMqtt Boolean       @default(false)
  id            String        @id @default(uuid())
  name          String
  description   String?
  schema        String
  // Superseded by `cadence` and no longer read or written; kept until a later migration drops it
  frequency     String        @default("daily")
  // How often the habit is meant to be done, as JSON (see src/lib/cadence.ts)
  cadence       String        @default("{\"type\":\"daily\",\"timesPerDay\":1}")
  // The habit's owner: the only user who can edit, share, or delete it
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  members       HabitMember[]
  logs          HabitLog[]
  createdAt     DateTime      @default(now())

  @@index([userId])
}

// A user's access to a habit (the owner's own, or one shared with them), and where it sits in
// that user's own category tree. Placement is per user, since each person files a shared habit
// into their own categories.
model HabitMember {
  habitId    String
  habit      Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  order      Int       @default(0)
  isFavorite Boolean   @default(false)
  // The user's own notes on how they do this habit (e.g. "my bike commute is 4 miles, 30 minutes"),
  // given to the AI when matching and filling in their entries
  aiContext  String?
  createdAt  DateTime  @default(now())

  @@id([habitId, userId])
  @@index([userId, categoryId])
  @@index([categoryId])
}

model Category {
  id           String        @id @default(uuid())
  name         String
  icon         String?
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  habitMembers HabitMember[]
  parentId     String?
  order        Int           @default(0)
  parent       Category?     @relation("Subcategories", fields: [parentId], references: [id])
  children     Category[]    @relation("Subcategories")
  createdAt    DateTime      @default(now())

  @@index([userId, parentId])
  @@index([parentId])
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  payload   String
  createdAt DateTime @default(now())

  // History, calendars, and heatmaps all read a habit's logs by date range
  @@index([habitId, createdAt])
  @@index([userId])
}

model RateLimit {
  identifier String   @id
  count      Int      @default(1)
  resetTime  DateTime
}
