generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(uuid())
  name                String
  email               String             @unique
  // Null for an account that signs in with a provider instead (see Identity), as on the hosted version
  passwordHash        String?
  isAdmin             Boolean            @default(false)
  habitLogs           HabitLog[]
  habits              Habit[]
  habitMemberships    HabitMember[]
  categories          Category[]
  bedtime             String             @default("01:00")
  weekStartsOn        String             @default("sunday")
  useEmojiTitle       Boolean            @default(true)
  emojiModifier       String?
  passwordNeedsUpdate Boolean            @default(false)
  unitSystem          String             @default("imperial")
  // The time zone the user's browser last reported (see TimeZoneSync), for reminders, which are
  // sent with no request to read it from
  timeZone            String?
  createdAt           DateTime           @default(now())
  sessions            Session[]
  pushSubscriptions   PushSubscription[]
  remindersSent       ReminderSent[]
  habitSkips          HabitSkip[]
  vacations           Vacation[]
  apiKeys             ApiKey[]
  identities          Identity[]
  connectionsA        Connection[]       @relation("ConnectionA")
  connectionsB        Connection[]       @relation("ConnectionB")
}

// Two people who can see each other's names and share habits with each other (see
// src/lib/connections.ts). On a self-hosted server, everyone is connected to everyone, made as each
// person is added; on the hosted version, when one accepts the other's invite. Mutual, so one row
// per pair, with the smaller user id as `userA`.
model Connection {
  userAId   String
  userA     User     @relation("ConnectionA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("ConnectionB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userAId, userBId])
  @@index([userBId])
}

// An account at a sign-in provider (e.g. Google) that signs in as a user. Found by the provider's
// own id for the account (`subject`, the ID token's `sub`), never by email: emails change, and some
// providers hand out relay addresses. `email` is what the provider last said, for reference.
model Identity {
  id        String   @id @default(uuid())
  provider  String
  subject   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String?
  createdAt DateTime @default(now())

  @@unique([provider, subject])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Habit {
  publishToMqtt    Boolean        @default(false)
  id               String         @id @default(uuid())
  name             String
  description      String?
  schema           String
  // How often the habit is meant to be done, as JSON (see src/lib/cadence.ts)
  cadence          String         @default("{\"type\":\"daily\",\"timesPerDay\":1}")
  // Values worked out from each entry's fields (e.g. pace from duration and distance), as a JSON
  // array (see src/lib/calculatedFields.ts)
  calculatedFields String         @default("[]")
  // Charts the owner made of its entries (several lines, rolled up by period), as a JSON array (see
  // src/lib/charts.ts). Each field also gets a chart of its own, which isn't stored.
  charts           String         @default("[]")
  // The habit's owner: the only user who can edit, share, or delete it
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  members          HabitMember[]
  logs             HabitLog[]
  remindersSent    ReminderSent[]
  skips            HabitSkip[]
  createdAt        DateTime       @default(now())

  @@index([userId])
}

// A user's access to a habit (the owner's own, or one shared with them), and where it sits in
// that user's own category tree. Placement is per user, since each person files a shared habit
// into their own categories.
model HabitMember {
  habitId       String
  habit         Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  order         Int       @default(0)
  // The user's own notes on how they do this habit (e.g. "my bike commute is 4 miles, 30 minutes"),
  // given to the AI when matching and filling in their entries
  aiContext     String?
  // Whether this user gets a reminder when they're running late on this habit (see
  // src/lib/reminders.ts), and at what time ("HH:MM") if they set one rather than letting it be
  // learned from when the habit is usually logged
  remind        Boolean   @default(false)
  remindAt      String?
  // When reminders for it were paused after going unanswered several times in a row; null while
  // they're active. Turning them back on clears it.
  remindMutedAt DateTime?
  createdAt     DateTime  @default(now())

  @@id([habitId, userId])
  @@index([userId, categoryId])
  @@index([categoryId])
}

model Category {
  id           String         @id @default(uuid())
  name         String
  icon         String?
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  habitMembers HabitMember[]
  parentId     String?
  order        Int            @default(0)
  // How often the user means to do something in this category (any of its habits, its
  // subcategories' included), as JSON (see src/lib/cadence.ts). No cadence unless they set one.
  cadence      String         @default("{\"type\":\"none\"}")
  parent       Category?      @relation("Subcategories", fields: [parentId], references: [id])
  children     Category[]     @relation("Subcategories")
  skips        CategorySkip[]
  createdAt    DateTime       @default(now())

  @@index([userId, parentId])
  @@index([parentId])
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  payload   String
  createdAt DateTime @default(now())

  // History, calendars, and heatmaps all read a habit's logs by date range
  @@index([habitId, createdAt])
  @@index([userId])
}

// A day a habit was skipped (e.g. sick, traveling), as a civil day key ("2026-10-09") in the time
// zone of whoever skipped it. It excuses the habit without being an entry, however many entries it
// takes: a daily habit's day, a weekly one's week, a fifth of an every-N-days one's stretch (see
// skips in src/lib/cadence.ts). Like entries, it's the habit's, not one member's: anyone who has
// the habit can skip it, for everyone.
model HabitSkip {
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  day       String
  // Who skipped it
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([habitId, day])
  @@index([userId])
}

// A day a category with a cadence was skipped (or for an every-N-days one, postponed), as a civil
// day key like HabitSkip's. It excuses the category's own cadence (see skips in src/lib/cadence.ts),
// not its habits, which have their own; and a habit's skip doesn't count toward its category.
model CategorySkip {
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  day        String
  createdAt  DateTime @default(now())

  @@id([categoryId, day])
}

model RateLimit {
  identifier String   @id
  count      Int      @default(1)
  resetTime  DateTime
}

// A browser or device the user turned on reminders for (a Web Push subscription)
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// A reminder sent to a user about a habit on one of their days (a civil day key, "2026-10-09"), so
// each habit is mentioned at most once a day. Habits sent together share `sentAt`, which is how the
// day's notifications are counted against the daily limit.
model ReminderSent {
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId String
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  day     String
  sentAt  DateTime @default(now())

  @@id([userId, habitId, day])
  @@index([userId, day])
}

// Values the server generates once and keeps, e.g. its Web Push (VAPID) keys
model AppSetting {
  key   String @id
  value String
}

// A stretch of days the user is away: every habit and category of theirs counts as skipped on each
// of them (see src/lib/vacation.ts), as civil day keys like HabitSkip's, both inclusive. `to` is null
// until it's ended, for one with no end set. Ending one early keeps the days already taken.
model Vacation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  from      String
  to        String?
  createdAt DateTime @default(now())

  @@index([userId])
}


// A key another app (a shortcut, Home Assistant) uses to log entries as the user through the API, and
// read a habit's recent ones (see src/lib/apiKeys.ts). Only its hash is kept: the key itself is shown
// once, when it's made.
model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // What the user called it, e.g. "iPhone Shortcuts"
  name       String
  // The key's SHA-256, as hex
  hash       String    @unique
  // The key's first few characters, for telling keys apart in the list
  prefix     String
  // What it's allowed to do: log entries, and read a habit's entries. Keys made before these existed
  // could do both.
  canLog     Boolean   @default(true)
  canRead    Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}
