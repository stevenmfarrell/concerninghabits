# Keep local state and secrets out of the image. The Dockerfile's `COPY . .` would otherwise send
# all of this into the build, and its runner stage copies the whole prisma/ folder into the image.

# Dependencies and build output are rebuilt inside the image (and host binaries may be for macOS)
node_modules
.next
out

# Secrets: configure these through the container's environment instead
.env
.env.*
!.env.example

# Local databases (e.g. prisma/dev.db holds real user data). Unlike .gitignore, a bare `*.db` here
# only matches the context root, so `**/` is needed to catch prisma/dev.db.
**/*.db
**/*.db-journal
prisma/prisma

# Not needed to build or run the app
.git
.github
.claude
.agents
.cursor
.devin
tests
coverage
*.tsbuildinfo
npm-debug.log*
.DS_Store
